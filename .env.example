# Copy this file to .env and adjust. Every value is optional; the defaults are shown.
# PowerShell:  Copy-Item .env.example .env

# --- Local model service (Ollama only; no paid or cloud APIs are used) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3:latest
EMBEDDING_MODEL=nomic-embed-text:latest
# Lighter alternative for low-memory machines (benchmark first, see README):
# LLM_MODEL=phi3:mini

LLM_TEMPERATURE=0.0
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=512
LLM_TIMEOUT_SECONDS=180
# json_schema = schema-constrained output (Ollama >= 0.5); json = plain JSON mode for older Ollama
LLM_STRUCTURED_OUTPUT=json_schema
LLM_JSON_RETRIES=1
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=32
# Leave unset to auto-select (nomic-embed-text gets "search_document: " / "search_query: ").
# EMBEDDING_DOCUMENT_PREFIX=
# EMBEDDING_QUERY_PREFIX=

# --- Storage ---
VECTOR_STORE_PATH=./data/chroma
COLLECTION_PREFIX=documents

# --- Ingestion ---
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=500
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval and answering ---
TOP_K=4
# 0.0 disables the similarity floor (similarity is used for ranking only)
MIN_SIMILARITY=0.0
MAX_RETRIES=2
MAX_GROUNDING_RETRIES=1
# Faster default: deterministic citation and number checks still run. Set true
# to add a separate LLM semantic fact-check (slower).
ENABLE_LLM_GROUNDING_CHECK=false
MAX_QUESTION_LENGTH=1000

# --- Which documents /ask searches when no document_id is given ---
# auto   = choose by relevance (fact questions search all documents; "what is this pdf about?"
#          picks one document: the one named in the question, else the most relevant, else the latest)
# latest = only the most recently uploaded document
DEFAULT_DOCUMENT_SCOPE=auto
# Passages (spread evenly through the document) used to answer "what is this document about?"
SUMMARY_MAX_CHUNKS=10

# --- Logging ---
LOG_LEVEL=INFO
